{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>luzifer/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG PNPM_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "pnpm/pnpm",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "allowedVersions": "<12.0",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "pnpm/pnpm"
      ]
    }
  ]
}
