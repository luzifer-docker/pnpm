{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>luzifer/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "ARG PNPM_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "pnpm/pnpm",
      "datasourceTemplate": "github-releases"
    }
  ]
}
